---
/**
 * BaseHead - kompletny <head> z SEO + OG + Twitter + JSON-LD + hreflang.
 *
 * Każda strona MUSI renderować to wewnątrz <head>. Wrap przez BaseLayout.
 *
 * Zawiera:
 * - <title>, <meta description>, <meta author>, <meta robots>
 * - <link rel="canonical">
 * - <link rel="alternate" hreflang="..."> (per-language)
 * - Open Graph (og:type, og:url, og:title, og:description, og:image, og:site_name, og:locale)
 * - Twitter Card
 * - <html lang> (przez BaseLayout, nie tu)
 * - JSON-LD Article / Person / WebSite
 * - <link rel="llm">  → wskazuje AI crawlerom gdzie llms.txt
 * - GSC verification meta (z PUBLIC_GSC_VERIFICATION env)
 *
 * Astro: `src/components/layout/BaseHead.astro`.
 */

import { SITE } from '@config/site';

type Locale = 'en' | 'pl';

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';

interface Props {
  title: string;
  description: string;
  canonical: string; // ABSOLUTE URL
  locale: Locale;
  alternates?: { en?: string; pl?: string } | undefined;
  ogImage?: string | undefined;
  pageType?: 'website' | 'article' | 'profile' | undefined;
  article?:
    | {
        publishedTime: string;
        modifiedTime?: string | undefined;
        author: string;
        tags: string[];
      }
    | undefined;
  robots?: string | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
}

const {
  title,
  description,
  canonical,
  locale,
  alternates,
  ogImage = `${SITE.url}/og-default.png`,
  pageType = 'website',
  article,
  robots = 'index, follow',
  jsonLd = [],
} = Astro.props;

const ogLocale = locale === 'en' ? 'en_US' : 'pl_PL';
const siteName = SITE.brand.name;
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;

// JSON-LD WebSite zawsze; Article jeśli pageType=article
const defaultSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: SITE.url,
    name: SITE.brand.name,
    description: SITE.description[locale],
    inLanguage: locale,
  },
];

if (article) {
  defaultSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    author: {
      '@type': 'Person',
      name: article.author,
      url: SITE.url,
    },
    datePublished: article.publishedTime,
    ...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
    keywords: article.tags.join(', '),
    image: ogImage,
    mainEntityOfPage: canonical,
    inLanguage: locale,
  });
}

const allSchemas = [...defaultSchemas, ...jsonLd];
---

<!-- Primary Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{gscVerification && <meta name="google-site-verification" content={gscVerification} />}
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author.name} />
<meta name="robots" content={robots} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical + hreflang -->
<link rel="canonical" href={canonical} />
{alternates?.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
{alternates?.pl && <link rel="alternate" hreflang="pl" href={alternates.pl} />}
{alternates?.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}

<!-- Open Graph -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(SITE.ogImage.width)} />
<meta property="og:image:height" content={String(SITE.ogImage.height)} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{
  article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- LLMs standard - niestandardowy rel, ale wskazuje AI crawlerom gdzie szukać -->
<link rel="llm" href="/llms.txt" />
<link rel="llm-full" href="/llms-full.txt" />

<!-- RSS -->
{
  SITE.features?.rss && (
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  )
}

<!-- JSON-LD schemas -->
{
  allSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
